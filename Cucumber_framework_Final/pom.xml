<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>firstpackage</groupId>
  <artifactId>Cucumber_framework_Final</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Cucumber_framework_Final</name>
  <url>http://www.example.com</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
  </properties>

  <dependencies>
	  
	  <!-- https://mvnrepository.com/artifact/io.cucumber/cucumber-java -->
<dependency>
    <groupId>io.cucumber</groupId>
    <artifactId>cucumber-java</artifactId>
    <version>7.18.1</version>
</dependency>

<!-- FIXED (Aug 2026 revision): a duplicate <plugin> block was sitting here,
     directly inside <dependencies>, which is not valid POM structure and
     is what caused "Unrecognised tag: 'plugin'" build failures. The correct,
     properly-placed maven-surefire-plugin already exists below inside
     <build><plugins>; this duplicate has been removed. -->

	  

<!-- https://mvnrepository.com/artifact/io.cucumber/cucumber-testng -->
<dependency>
    <groupId>io.cucumber</groupId>
    <artifactId>cucumber-testng</artifactId>
    <version>7.18.1</version>
</dependency>

<!-- https://mvnrepository.com/artifact/org.seleniumhq.selenium/selenium-java -->
<dependency>
    <groupId>org.seleniumhq.selenium</groupId>
    <artifactId>selenium-java</artifactId>
    <version>4.24.0</version>
</dependency>


<!-- FIXED (Aug 2026 revision): removed com.aventstack:extentreports-cucumber7-adapter
     here. This library's real Maven coordinate is
     tech.grasshopper:extentreports-cucumber7-adapter (already included further
     below); the com.aventstack version of this specific artifact does not
     exist on Maven Central and caused "Could not find artifact" build
     failures. The plain com.aventstack:extentreports (core library, not the
     adapter) below is unaffected and correct. -->


<!-- delete them later-->

<dependency>
    <groupId>org.slf4j</groupId>
    <artifactId>slf4j-api</artifactId>
    <version>1.7.5</version>
</dependency>
<dependency>
    <groupId>org.slf4j</groupId>
    <artifactId>slf4j-simple</artifactId>
    <version>1.6.4</version>
</dependency>




<dependency>
    <groupId>io.github.bonigarcia</groupId>
    <artifactId>webdrivermanager</artifactId>
    <version>5.9.2</version>
    <scope>test</scope>
</dependency>


<!-- https://mvnrepository.com/artifact/com.aventstack/extentreports -->
<dependency>
    <groupId>com.aventstack</groupId>
    <artifactId>extentreports</artifactId>
    <version>5.1.2</version>
</dependency>


<!-- for mailosaur to test email otp -->
<!-- https://mvnrepository.com/artifact/com.mailosaur/mailosaur-java -->
<dependency>
    <groupId>com.mailosaur</groupId>
    <artifactId>mailosaur-java</artifactId>
    <version>8.2.6</version>
</dependency>




<!-- https://mvnrepository.com/artifact/tech.grasshopper/extentreports-cucumber7-adapter -->
<dependency>
    <groupId>tech.grasshopper</groupId>
    <artifactId>extentreports-cucumber7-adapter</artifactId>
    <version>1.14.0</version>
</dependency>






  	<!-- FIXED (Aug 2026 revision): removed NSY:Cucumber:0.0.1-SNAPSHOT.
       This was not a real published artifact (it appears to reference this
       project's own group/version placeholder) and Maven Central correctly
       could not find it, causing "Could not find artifact" build failures.
       It served no purpose in the dependency list. -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- FIXED (Aug 2026 revision): bumped from 3.0.0-M5 and merged in the
             <includes> pattern from the removed duplicate block above.
             Without this, Surefire's default file-name patterns (Test*.java,
             *Test.java, *Tests.java, *TestCase.java) do NOT match
             "TestNGTestRunner.java", so the test runner could be silently
             skipped entirely. -->
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/*Runner.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
